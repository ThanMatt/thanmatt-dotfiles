set $tertiary           #b8c6ea
set $error              #ffb4ab
set $surface            #0e1415
set $on_surface         #dee4e4
set $on_surface_variant #bec8c9
set $outline            #899294

## Window Colours
# class                 border    backgr.   text                indicator  child_border
