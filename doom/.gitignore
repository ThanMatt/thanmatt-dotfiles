# :: Local Claude Code settings (machine-specific, not for the repo)
.claude/

# :: Local environment files (secrets live in ~/.config/fish/conf.d/local.fish)
.env
.env.local
env.fish

# :: Machine-local Doom overrides -- employer paths / project names, i.e. the
# :: things that must not reach a public repo. +local.el.example IS tracked.
+local.el

# :: Employer worktree tooling (project name, checkout paths, port layout).
# :: Loaded only if present -- see the `file-exists-p' guard in config.el.
modules/worktree.el

# :: Backup / auto-generated files
*.backup
*~
\#*\#
*.elc
auto-save-list/
network-security.data

# :: Sensitive data
*.secret
*.private

# :: macOS
.DS_Store
