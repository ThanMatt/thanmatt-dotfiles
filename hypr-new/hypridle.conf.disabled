# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
# :: DISABLED (2026-08-28) — Noctalia v5 owns idle + lock now.  --
# :: hypridle is no longer autostarted from hyprland.lua, and    --
# :: this file is renamed .disabled so hypridle would find no    --
# :: config even if something started it. Noctalia holds its own --
# :: logind sleep inhibitor ("Lock before sleep"), which was the --
# :: only job left here. Re-enable: rename back to hypridle.conf --
# :: and restore the autostart line in hyprland.lua.             --
# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
# :: HYPRIDLE — sleep/lock broker ONLY (no idle timeouts)     --
# ::                                                          --
# :: Noctalia still owns idle (screen-off / idle-lock /       --
# :: idle-suspend) via its own IdleService. There are         --
# :: deliberately NO `listener {}` blocks here, so hypridle   --
# :: adds no idle timers and cannot conflict with Noctalia.   --
# ::                                                          --
# :: Its one job: hold a logind sleep inhibitor so hyprlock   --
# :: is up BEFORE any suspend (lid, session menu, `systemctl  --
# :: suspend`, low battery) — the piece plain systemd can't   --
# :: do here (this box has no user-level sleep.target).       --
# :: Also answers `loginctl lock-session` -> hyprlock.        --
# ::                                                          --
# :: Started from hyprland.lua autostart (`hypridle`).        --
# :: Requires: pacman -S hypridle                             --
# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

general {
    # :: `pidof` guard = never stack a second hyprlock instance.
    lock_cmd         = pidof hyprlock || hyprlock   # :: loginctl lock-session
    before_sleep_cmd = pidof hyprlock || hyprlock   # :: lock before suspend
    after_sleep_cmd  = hyprctl dispatch dpms on     # :: wake display in one keypress
}
